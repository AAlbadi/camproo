# =================================================================
# CampRoo API Configuration
# =================================================================
# NOTE: Zero-configuration sandbox is active by default.
# The app and all sign-ins work immediately out of the box.
# Below are your options when you want live production keys:

PORT=3001

# =================================================================
# ⭐ OPTION A (RECOMMENDED): 1 SINGLE API KEY FOR EVERYTHING
# =================================================================
# Want to avoid making separate developer accounts at Google, Facebook & Apple?
# Use Clerk (100% Free tier up to 10,000 monthly active users).
# Sign up at https://clerk.com, click "Create Application",
# and just flip the toggle ON for:
#   [x] Google
#   [x] Facebook
#   [x] Apple
# Then copy your ONE Publishable Key here:
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Or if you prefer Supabase (Free tier up to 50,000 monthly active users):
# 1. Sign up at https://supabase.com and click "New Project"
# 2. Go to Project Settings -> API and copy:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =================================================================
# OPTION B (DIRECT APIS): If you prefer your own individual developer keys
# =================================================================

# 1. Google Sign-In
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 2. Facebook Login (Very popular with RVers & camping groups)
# https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# 3. Apple Sign-In (For iPhone / iPad travelers)
# https://developer.apple.com
APPLE_CLIENT_ID=com.camproo.app.service

# =================================================================
# EMAIL & NEWSLETTER NOTIFICATIONS (FREE TIER)
# =================================================================
# Resend (Recommended - 3,000 free emails/mo): https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=CampRoo Community <welcome@camproo.com>

# SendGrid (Alternative):
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
